{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist-server",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["api", "src/lib/retrieval.ts", "src/lib/textEmbedding.ts", "src/lib/buildRetrievalQuery.ts", "src/lib/citationValidation.ts", "src/lib/confidenceScoring.ts", "src/data/**/*.ts", "src/data/**/*.json", "src/types/**/*.ts"]
}
